<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/widget_background">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAILY GROWTH"
            android:textColor="#B8CBD1"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="baseline"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F2F6F5"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="sans" />
            <TextView
                android:id="@+id/widget_day_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="DAYS"
                android:textColor="#A8C9A7"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One day at a time"
            android:textColor="#B8CBD1"
            android:textSize="10sp" />
    </LinearLayout>
    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="✦"
        android:textColor="#A8C9A7"
        android:textSize="24sp" />
</LinearLayout>
